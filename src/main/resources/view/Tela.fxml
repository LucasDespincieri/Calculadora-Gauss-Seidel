<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f4f6f8; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller=" br.com.amumus.controller.TelaController">

    <Label text="Método de Gauss-Seidel" textFill="#333333">
        <font><Font name="System Bold" size="24.0" /></font>
    </Label>

    <HBox alignment="CENTER" spacing="20.0">
        <ComboBox fx:id="boxTamanho" prefWidth="150.0" style="-fx-background-radius: 5; -fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 5;" />
        <VBox alignment="CENTER_LEFT">
            <Label text="Condição de Parada (Epsilon):" font="$x1"/>
            <TextField fx:id="txtEpsilon" text="0.05" prefWidth="80.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ccc; -fx-background-color: white;" />
        </VBox>
    </HBox>

    <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;">
        <Label text="Insira os coeficientes do Sistema:" font="$x1">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>

        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="a11" prefWidth="60.0" promptText="a1" /> <Label text="X  +" />
            <TextField fx:id="a12" prefWidth="60.0" promptText="b1" /> <Label text="Y  +" />
            <TextField fx:id="a13" prefWidth="60.0" promptText="c1" /> <Label text="Z  =" />
            <TextField fx:id="d1" prefWidth="60.0" promptText="d1" style="-fx-border-color: #4CAF50;" />
        </HBox>

        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="a21" prefWidth="60.0" promptText="a2" /> <Label text="X  +" />
            <TextField fx:id="a22" prefWidth="60.0" promptText="b2" /> <Label text="Y  +" />
            <TextField fx:id="a23" prefWidth="60.0" promptText="c2" /> <Label text="Z  =" />
            <TextField fx:id="d2" prefWidth="60.0" promptText="d2" style="-fx-border-color: #4CAF50;" />
        </HBox>

        <HBox fx:id="linha3" alignment="CENTER" spacing="10.0">
            <TextField fx:id="a31" prefWidth="60.0" promptText="a3" /> <Label text="X  +" />
            <TextField fx:id="a32" prefWidth="60.0" promptText="b3" /> <Label text="Y  +" />
            <TextField fx:id="a33" prefWidth="60.0" promptText="c3" /> <Label text="Z  =" />
            <TextField fx:id="d3" prefWidth="60.0" promptText="d3" style="-fx-border-color: #4CAF50;" />
        </HBox>

        <Button onAction="#calcular" text="Calcular Raízes" prefWidth="200.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8;">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
        </Button>
    </VBox>

    <HBox alignment="CENTER" spacing="20.0">
        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <Label text="Resultados:" textFill="#888888" />
            <Label fx:id="lblResultadoX" text="X = --" font="$x1"><font><Font name="System Bold" size="16.0" /></font></Label>
            <Label fx:id="lblResultadoY" text="Y = --" font="$x1"><font><Font name="System Bold" size="16.0" /></font></Label>
            <Label fx:id="lblResultadoZ" text="Z = --" font="$x1"><font><Font name="System Bold" size="16.0" /></font></Label>
        </VBox>
        <VBox alignment="CENTER" prefHeight="100.0" prefWidth="150.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <Label fx:id="lblIteracoes" text="Iterações: --" textFill="#555555" />
            <Label fx:id="lblErro" text="Erro (ER): --" textFill="#555555" />
        </VBox>
    </HBox>

</VBox>